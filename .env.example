# ============================================================================
# PROPIEDAD INTELECTUAL Y LICENCIA COMERCIAL CERRADA - ORANGE CREW
# ============================================================================

# Entorno de despliegue
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=TU_CLAVE_SECRETA_AQUI

# Base de datos
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Otros servicios
REDIS_URL=redis://localhost:6379/0

# ContpaqiBridge (ver contpaqi-bridge/README.md)
CONTPAQI_BRIDGE_URL=http://host.docker.internal:5005
CONTPAQI_BRIDGE_TIMEOUT=30
CONTPAQI_BRIDGE_REINTENTOS=2
