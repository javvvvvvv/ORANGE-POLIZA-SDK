# Copia este archivo a ".env" (en esta misma carpeta) y llena los datos
# reales de tu servidor PostgreSQL. instalar_postgres.bat genera este
# archivo automáticamente en la computadora que actúa como servidor.

ORANGE_DB_HOST=localhost
ORANGE_DB_PORT=5432
ORANGE_DB_NAME=orange_poliza
ORANGE_DB_USER=orange_app
